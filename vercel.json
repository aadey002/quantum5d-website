{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.quantum5dconsulting.com" }],
      "destination": "https://quantum5dconsulting.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|assets|images|resources|robots.txt|sitemap.xml|logo.png).*)", "destination": "/index.html" }
  ]
}
